# Copy to .env.local for local development.
# Never commit real Convex deployments, site URLs, Meta tokens, or app secrets.

CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_SITE_URL=

# Vercel/CI deployment only. Store in Vercel env vars, never in Git.
CONVEX_DEPLOY_KEY=

# Meta Graph / WhatsApp Business Platform
META_GRAPH_VERSION=v25.0
PLATFORM_META_VERIFY_TOKEN=
PLATFORM_META_APP_SECRET=

# Embedded Signup provider app config
META_EMBEDDED_SIGNUP_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_EMBEDDED_SIGNUP_REDIRECT_URI=
META_EMBEDDED_SIGNUP_APP_SECRET=

# 32 bytes as 64 hex chars or base64. Required outside tests.
WABA_TOKEN_ENCRYPTION_KEY_V1=
