# Copy to .env.local for local development.
# Never commit real Convex deployments, site URLs, Meta tokens, or app secrets.

CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_SITE_URL=
SITE_URL=

# Vercel/CI deployment only. Store in Vercel env vars, never in Git.
CONVEX_DEPLOY_KEY=

# Convex Auth. Generate per deployment; never reuse demo/test values.
JWT_PRIVATE_KEY=
JWKS=

# Meta Graph / WhatsApp Business Platform
META_GRAPH_VERSION=v25.0
PLATFORM_META_VERIFY_TOKEN=
PLATFORM_META_APP_SECRET=

# Embedded Signup provider app config
META_EMBEDDED_SIGNUP_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_EMBEDDED_SIGNUP_REDIRECT_URI=
META_EMBEDDED_SIGNUP_APP_SECRET=

# 32 bytes as 64 hex chars or base64. Required outside tests.
WABA_TOKEN_ENCRYPTION_KEY_V1=

# iaSolution Hub territory gates. Configure only the authorized OpenBSP lab
# channel. Comma-separated; never commit real identifiers.
OPENBSP_ALLOWED_HUB_CHANNEL_IDS=
OPENBSP_ALLOWED_PHONE_NUMBERS=
OPENBSP_ALLOWED_WABA_IDS=

# Optional defense-in-depth for known reserved operation identifiers.
# Protected matches override allowed matches and fail closed before network use.
OPENBSP_PROTECTED_HUB_CHANNEL_IDS=
OPENBSP_PROTECTED_PHONE_NUMBERS=
OPENBSP_PROTECTED_WABA_IDS=
